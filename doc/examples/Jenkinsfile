// EXAMPLE ONLY: copy into a separately reviewed Jenkins job to activate.
// The default release pin is intentionally invalid. No timer trigger is defined.
// This job runs a certificate producer with real S3/Route53 authority when enabled.
pipeline {
  agent { label 'certbotbot-trusted-linux' }

  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds(abortPrevious: false)
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }

  parameters {
    string(name: 'DOMAIN', defaultValue: 'example.com',
      description: 'Primary DNS name; replace the documentation placeholder')
    string(name: 'S3_BUCKET', defaultValue: '',
      description: 'Existing seeded certificate archive bucket (required)')
    string(name: 'S3_KEY', defaultValue: 'latest.tar.gz',
      description: 'Existing current object; never point at a dated recovery key')
    string(name: 'CERT_NAME', defaultValue: '',
      description: 'Optional stable non-wildcard Certbot lineage name')
    choice(name: 'INCLUDE_SUBDOMAINS', choices: ['true', 'false'],
      description: 'Complement every requested apex or wildcard name')
    choice(name: 'DATED_BACKUP_ENABLED', choices: ['false', 'true'],
      description: 'Opt in only after reviewing managed backup permissions')
    string(name: 'BACKUP_RETENTION_COUNT', defaultValue: '0',
      description: '0 disables deletion; positive values can delete older backups')
    choice(name: 'ARCHIVE_ENCRYPTION', choices: ['none', 'gpg-ocb'],
      description: 'Selected existing archive mode; do not use for migration')
  }

  environment {
    // Replace BOTH with independently reviewed immutable release values.
    // The SHA is operator-pinned separately from the downloaded sidecar.
    CERTBOTBOT_RELEASE_TAG = 'REPLACE_WITH_REVIEWED_TAG'
    CERTBOTBOT_RELEASE_SHA256 = 'REPLACE_WITH_REVIEWED_SHA256'
    // AWS region and role/credential chain come from the trusted agent.
  }

  stages {
    stage('Validate operator preconditions') {
      steps {
        sh '''#!/usr/bin/env bash
set -euo pipefail
set +x
umask 077
[[ "$CERTBOTBOT_RELEASE_TAG" =~ ^v[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
  printf '%s\n' 'Choose a reviewed immutable release tag before enabling this job' >&2
  exit 64
}
[[ "$CERTBOTBOT_RELEASE_SHA256" =~ ^[0-9a-f]{64}$ ]] || {
  printf '%s\n' 'Pin the reviewed producer SHA-256 before enabling this job' >&2
  exit 64
}
[[ -n "$S3_BUCKET" && "$S3_BUCKET" =~ ^[a-z0-9][a-z0-9.-]{1,61}[a-z0-9]$ &&
  "$S3_BUCKET" != *..* ]] || {
  printf '%s\n' 'Configure an existing valid S3 bucket' >&2
  exit 64
}
[[ -n "$DOMAIN" && "$DOMAIN" != example.com ]] || {
  printf '%s\n' 'Replace the example primary DNS name with a reviewed identity' >&2
  exit 64
}
[[ -n "$S3_KEY" && "$S3_KEY" != -* && "$S3_KEY" != */* &&
  "$S3_KEY" != *[[:space:]]* ]] || {
  printf '%s\n' 'Invalid S3 current object key' >&2
  exit 64
}
[[ "$INCLUDE_SUBDOMAINS" == true || "$INCLUDE_SUBDOMAINS" == false ]]
[[ "$DATED_BACKUP_ENABLED" == true || "$DATED_BACKUP_ENABLED" == false ]]
[[ "$ARCHIVE_ENCRYPTION" == none || "$ARCHIVE_ENCRYPTION" == gpg-ocb ]]
if [[ "$BACKUP_RETENTION_COUNT" != 0 ]]; then
  [[ "$BACKUP_RETENTION_COUNT" =~ ^[1-9][0-9]*$ &&
    "${#BACKUP_RETENTION_COUNT}" -le 5 ]] || exit 64
  (( 10#$BACKUP_RETENTION_COUNT <= 10000 )) || exit 64
  [[ "$DATED_BACKUP_ENABLED" == true ]] || {
    printf '%s\n' 'Retention requires explicitly enabled dated backups' >&2
    exit 64
  }
fi
for tool in bash aws certbot openssl tar gzip sha256sum curl; do
  command -v "$tool" >/dev/null || {
    printf 'Missing trusted runner tool: %s\n' "$tool" >&2
    exit 69
  }
done
(( BASH_VERSINFO[0] > 4 ||
   (BASH_VERSINFO[0] == 4 && BASH_VERSINFO[1] >= 3) )) || exit 69
aws --version 2>&1 | grep -Eq '^aws-cli/2\.' || exit 69
if [[ "$ARCHIVE_ENCRYPTION" == gpg-ocb ]]; then
  command -v gpg >/dev/null || exit 69
fi
# This checks local tool availability, not real AWS or ACME permission.
'''
      }
    }

    stage('Retrieve and independently pin ordinary producer') {
      steps {
        sh '''#!/usr/bin/env bash
set -euo pipefail
set +x
umask 077
target="$WORKSPACE/.certbotbot-example"
[[ ! -e "$target" && ! -L "$target" ]] || {
  printf '%s\n' 'Refusing occupied download directory' >&2
  exit 65
}
mkdir -m 0700 -- "$target"
cd -- "$target"
url="https://github.com/wesley-dean/certbotbot/releases/download/$CERTBOTBOT_RELEASE_TAG"
curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 \
  --output certbotbot.bash "$url/certbotbot.bash"
curl --fail --location --silent --show-error --proto '=https' --tlsv1.2 \
  --output certbotbot.bash.sha256 "$url/certbotbot.bash.sha256"
[[ -s certbotbot.bash && -f certbotbot.bash.sha256 &&
  ! -L certbotbot.bash && ! -L certbotbot.bash.sha256 ]]
[[ "$(wc -l < certbotbot.bash.sha256)" == 1 ]] || exit 65
sha256sum --check --status certbotbot.bash.sha256 || exit 65
actual="$(sha256sum certbotbot.bash | awk '{print $1}')"
[[ "$actual" == "$CERTBOTBOT_RELEASE_SHA256" ]] || {
  printf '%s\n' 'Reviewed immutable SHA-256 does not match downloaded producer' >&2
  exit 65
}
bash -n certbotbot.bash
chmod 0700 certbotbot.bash
'''
      }
    }

    stage('Execute verified selected-lineage producer') {
      steps {
        script {
          // Groovy never interpolates parameters or any secret into this script.
          // Bash receives each value as one quoted argv item, without eval.
          String invokeProducer = '''#!/usr/bin/env bash
set -euo pipefail
set +x
umask 077
producer="$WORKSPACE/.certbotbot-example/certbotbot.bash"
[[ -f "$producer" && ! -L "$producer" ]] || exit 69
args=(--s3-bucket "$S3_BUCKET"
  --s3-key "$S3_KEY"
  --include-subdomains "$INCLUDE_SUBDOMAINS"
  --dated-backup-enabled "$DATED_BACKUP_ENABLED"
  --backup-retention-count "$BACKUP_RETENTION_COUNT"
  --upload-no-renewal false
  --archive-encryption "$ARCHIVE_ENCRYPTION")
if [[ -n "$CERT_NAME" ]]; then
  args+=(--cert-name "$CERT_NAME")
fi
args+=("$DOMAIN")
# Do not capture/suppress exit status. Current PUT can be uncertain and
# dated-backup/retention partial success must fail the calling build.
exec bash "$producer" "${args[@]}"
'''
          if (params.ARCHIVE_ENCRYPTION == 'gpg-ocb') {
            withCredentials([
              string(credentialsId: 'certbotbot-gpg-symmetric-key',
                variable: 'GPG_SYMMETRIC_KEY')
            ]) {
              sh(script: invokeProducer)
            }
          } else {
            // Plaintext runs do not bind or inherit a GPG secret by design.
            sh(script: invokeProducer)
          }
        }
      }
    }
  }

  post {
    always {
      // Removes the downloaded executable and any workspace data.
      // Runtime certificate state is owned/cleaned by the producer itself.
      deleteDir()
    }
  }
}
